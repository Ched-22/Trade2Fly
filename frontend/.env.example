# Dev: backend URL for Vite proxy (/api and /socket.io). Backend must be running on this port.
VITE_DEV_API_URL=http://localhost:3000

# Production: full API origin, or leave empty for same-origin /api
VITE_API_BASE_URL=

# WebSocket: backend origin in production only. Dev uses Vite proxy — leave empty.
VITE_WS_URL=

# Socket.IO path on the backend (default /socket.io)
VITE_WS_PATH=/socket.io

# If Vite uses port 5174 (5173 busy), ensure backend WS_CORS_ORIGIN includes http://localhost:5174
