generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingSaleMode {
  direct
  offersOnly
}

enum CheckoutGrantStatus {
  active
  used
  revoked
  expired
}

enum MessageType {
  text
  offer
  offer_accepted
  offer_declined
}

enum UserRole {
  user
  admin
}

enum OrderStatus {
  awaiting_payment
  awaiting_shipment
  shipment_in_progress
  shipped
  disputed
  return_in_progress
  completed
  cancelled
  refunded
}

enum NotificationType {
  order_purchased
  order_shipped
  order_completed
  order_auto_completed
  order_disputed
  dispute_admin_replied
  dispute_buyer_replied
  return_approved
  return_received
  checkout_available
}

enum OrderProofKind {
  product_photo
  boxed_photo
  packing_video
  unboxing_video
  received_photo
}

enum PaymentMethodType {
  card
  pix
}

enum EscrowStatus {
  not_applicable
  held
  released
  refunded
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  displayName     String
  initials        String
  /// false = inativo (aguardando confirmação manual); true = pode entrar
  active          Boolean  @default(false)
  role            UserRole @default(user)
  cpfCnpj         String?
  asaasCustomerId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Chave Pix de recebimento do vendedor. O valor da venda fica retido na conta principal da
  /// Trade2Fly e só é transferido para essa chave quando o comprador confirma o recebimento.
  payoutPixKeyType      String?
  payoutPixKeyEncrypted String?
  payoutPixKeyMasked    String?

  /// Dados de perfil público (editáveis em Perfil > Dados de contato).
  firstName String?
  lastName  String?
  bio       String?
  city      String?
  dropzone  String?
  phone     String?
  avatarUrl String?

  listings             Listing[]
  favorites            Favorite[]
  messages             Message[]
  buyerThreads         ChatThread[]         @relation("BuyerThreads")
  sellerThreads        ChatThread[]         @relation("SellerThreads")
  threadReads          ChatThreadRead[]
  orders               Order[]
  resetTokens          PasswordResetToken[]
  checkoutGrants       CheckoutGrant[]      @relation("BuyerGrants")
  sellerCheckoutGrants CheckoutGrant[]      @relation("SellerGrants")
  checkoutViolations   CheckoutViolation[]
  notifications        Notification[]
  orderProofFiles      OrderProofFile[]
  paymentMethods       PaymentMethod[]
}

model Listing {
  id                    Int             @id @default(autoincrement())
  title                 String
  priceNum              Float
  specs                 String          @default("")
  size                  String?
  jumps                 String?
  year                  String?
  weight                String?
  brand                 String?
  category              String
  condition             String
  location              String
  postalCode            String?
  escrow                Boolean         @default(false)
  description           String?
  imageUrls             String[]        @default([])
  active                Boolean         @default(true)
  saleMode              ListingSaleMode @default(direct)
  sellerId              String
  sellerTermsAcceptedAt DateTime?
  sellerTermsVersion    String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  seller             User                @relation(fields: [sellerId], references: [id])
  favorites          Favorite[]
  threads            ChatThread[]
  orders             Order[]
  checkoutGrants     CheckoutGrant[]
  checkoutViolations CheckoutViolation[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String
  listingId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([userId, listingId])
}

model ChatThread {
  id        Int      @id @default(autoincrement())
  buyerId   String
  sellerId  String
  listingId Int
  createdAt DateTime @default(now())

  buyer          User             @relation("BuyerThreads", fields: [buyerId], references: [id])
  seller         User             @relation("SellerThreads", fields: [sellerId], references: [id])
  listing        Listing          @relation(fields: [listingId], references: [id])
  messages       Message[]
  reads          ChatThreadRead[]
  checkoutGrants CheckoutGrant[]

  @@unique([buyerId, listingId])
}

model ChatThreadRead {
  userId   String
  threadId Int
  readAt   DateTime @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([userId, threadId])
  @@map("chat_thread_reads")
}

model Message {
  id          Int         @id @default(autoincrement())
  threadId    Int
  senderId    String
  text        String
  messageType MessageType @default(text)
  offerAmount Float?
  createdAt   DateTime    @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id])
  sender User       @relation(fields: [senderId], references: [id])
}

model CheckoutGrant {
  id          Int                 @id @default(autoincrement())
  listingId   Int
  threadId    Int
  buyerId     String
  sellerId    String
  agreedPrice Float
  status      CheckoutGrantStatus @default(active)
  expiresAt   DateTime
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  listing Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  thread  ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  buyer   User       @relation("BuyerGrants", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User       @relation("SellerGrants", fields: [sellerId], references: [id], onDelete: Cascade)
}

model CheckoutViolation {
  id              Int      @id @default(autoincrement())
  userId          String
  listingId       Int
  attemptedAmount Float
  agreedPrice     Float
  createdAt       DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Order {
  id                     Int          @id @default(autoincrement())
  buyerId                String
  listingId              Int
  amount                 Float
  /// Valor efetivamente cobrado do comprador (amount + frete + seguro + juros do cartão). Igual à soma dos três primeiros para Pix/boleto.
  chargeAmount           Float?
  /// Frete de ida cobrado junto, SEPARADO do produto: fora da base de comissão e não repassado ao vendedor (destinado à Loggi).
  shippingAmount         Float        @default(0)
  /// Seguro de frete opcional (também separado do produto e fora da comissão).
  shippingInsurance      Float        @default(0)
  /// 'shipping' (envio) ou 'pickup' (retirada em mãos).
  deliveryMode           String       @default("shipping")
  shippingZip            String?
  shippingStreet         String?
  shippingNumber         String?
  shippingComplement     String?
  shippingDistrict       String?
  shippingCity           String?
  shippingState          String?
  /// Preenchido pelo rastreio da Loggi (pós-integração); marca o início da janela de 7 dias da disputa.
  deliveredAt            DateTime?
  paymentType            String
  installments           Int?
  cpfCnpj                String?
  asaasCustomerId        String?
  asaasPaymentId         String?      @unique
  asaasPaymentStatus     String?
  pixPayload             String?
  pixQrCodeBase64        String?
  bankSlipUrl            String?
  invoiceUrl             String?
  status                 OrderStatus  @default(awaiting_payment)
  /// True when this completed sale was the seller's first — no Trade2Fly commission.
  commissionExempt       Boolean      @default(false)
  shippedAt              DateTime?
  buyerConfirmedAt       DateTime?
  disputedAt             DateTime?
  disputeReason          String?
  autoCompleteAt         DateTime?
  completedAt            DateTime?
  stripePaymentIntentId  String?
  /// Situação do valor retido na conta principal da Trade2Fly (só transferido ao vendedor quando o comprador confirma o recebimento).
  escrowStatus           EscrowStatus @default(held)
  sellerPayoutTransferId String?
  escrowReleasedAt       DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  buyer         User             @relation(fields: [buyerId], references: [id])
  listing       Listing          @relation(fields: [listingId], references: [id])
  proofFiles    OrderProofFile[]
  notifications Notification[]
  dispute       OrderDispute?
  orderReturn   OrderReturn?
}

enum DisputeStatus {
  awaiting_admin
  awaiting_buyer
  resolved
}

enum DisputeOutcome {
  buyer_satisfied
  refund_buyer
  release_seller
  return_and_refund
}

/// Motivo informado pelo comprador. `withdrawal` = desistência sem defeito (frete de volta pago pelo comprador).
enum DisputeReason {
  defect
  not_as_described
  withdrawal
}

enum ReturnShippingPayer {
  seller
  buyer
}

enum ReturnStatus {
  awaiting_label
  label_issued
  in_transit
  received
  refunded
  cancelled
}

enum DisputeAuthorType {
  buyer
  admin
}

/// Disputa aberta pelo comprador. Conversa comprador <-> admin (o vendedor só é avisado).
model OrderDispute {
  id                 Int             @id @default(autoincrement())
  orderId            Int             @unique
  status             DisputeStatus   @default(awaiting_admin)
  outcome            DisputeOutcome?
  reason             DisputeReason   @default(defect)
  openedAt           DateTime        @default(now())
  resolvedAt         DateTime?
  resolvedByAdminId  String?
  /// Última mensagem do comprador ainda sem resposta do admin (para ordenar a fila).
  lastBuyerMessageAt DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages DisputeMessage[]

  @@index([status, lastBuyerMessageAt])
}

/// Devolução física aprovada pelo admin. A etiqueta reversa virá da Loggi (pós-integração); até lá o admin informa rastreio/etiqueta.
model OrderReturn {
  id                Int                 @id @default(autoincrement())
  orderId           Int                 @unique
  status            ReturnStatus        @default(awaiting_label)
  /// Quem arca com o frete de volta: seller (defeito/diferente do anunciado) ou buyer (desistência sem defeito).
  shippingPayer     ReturnShippingPayer
  /// Estimativa do frete de volta (hoje = frete de ida; pós-Loggi = preço real da etiqueta).
  shippingCost      Float
  /// Valor devolvido ao comprador na Asaas.
  refundAmount      Float
  /// Quando o vendedor é o responsável: valor a recuperar do vendedor (cobrança ainda em aberto — ver checklist).
  sellerDebtAmount  Float               @default(0)
  trackingCode      String?
  labelUrl          String?
  approvedByAdminId String?
  shippedAt         DateTime?
  receivedAt        DateTime?
  refundedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DisputeMessage {
  id         Int               @id @default(autoincrement())
  disputeId  Int
  authorType DisputeAuthorType
  authorId   String
  body       String
  createdAt  DateTime          @default(now())

  dispute OrderDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId, createdAt])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  orderId   Int?
  listingId Int?
  createdAt DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model OrderProofFile {
  id              Int            @id @default(autoincrement())
  orderId         Int
  kind            OrderProofKind
  storageKey      String
  mimeType        String
  uploadedById    String
  durationSeconds Int?
  createdAt       DateTime       @default(now())

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([orderId, kind])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PaymentMethod {
  id                     String            @id @default(cuid())
  userId                 String
  type                   PaymentMethodType
  brand                  String?
  last4                  String?
  expMonth               Int?
  expYear                Int?
  holderName             String?
  pixKeyType             String?
  pixKeyEncrypted        String?
  pixKeyMasked           String?
  gatewayPaymentMethodId String?
  gatewayCustomerId      String?
  isDefault              Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
