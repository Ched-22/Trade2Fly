DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trade2fly?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000
FRONTEND_URL="http://localhost:5173"
# Comma-separated; include 5174 when Vite falls back (port 5173 busy)
WS_CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
WS_PATH="/socket.io"
NODE_ENV="development"
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MEDIA_PUBLIC_URL="http://localhost:3000"
MAX_LISTING_PHOTOS="8"
MAX_PHOTO_BYTES="2097152"
ADMIN_OWNER_EMAIL="owner@trade2fly.com"
ADMIN_CORS_ORIGIN="http://localhost:5174"
ORDER_AUTO_COMPLETE_DAYS="7"
ORDER_PROOF_PHOTO_MAX_MB="5"
ORDER_PROOF_VIDEO_MAX_MB="200"

# Métodos de pagamento (comprador)
PAYMENT_METHODS_ENABLED="true"
PAYMENT_GATEWAY_MODE="mock"
PAYMENT_DATA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
PAYMENT_RATE_LIMIT_PER_MIN="30"
# Stripe (obrigatório apenas quando PAYMENT_GATEWAY_MODE=stripe)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Loggi (cotação de frete no checkout)
LOGGI_API_URL="https://api.loggi.com"
LOGGI_CLIENT_ID=""
LOGGI_CLIENT_SECRET=""
LOGGI_COMPANY_ID=""
LOGGI_PICKUP_TYPE="PICKUP_TYPE_SPOT"

# Chat de suporte com IA (Groq — tier gratuito, https://console.groq.com/keys)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Asaas (checkout: Pix, boleto, cartão) — https://sandbox.asaas.com (dev) / https://www.asaas.com (produção)
# Conta principal da Trade2Fly: recebe o valor cheio de cada venda e transfere o líquido para a
# chave Pix do vendedor quando o comprador confirma o recebimento (ver AsaasPayoutsService).
ASAAS_API_KEY=""
# Token arbitrário que você define aqui e também cola na configuração do Webhook no painel Asaas
ASAAS_WEBHOOK_TOKEN=""
# A chave Pix de cada vendedor é criptografada com PAYMENT_DATA_ENCRYPTION_KEY (já configurada acima).
